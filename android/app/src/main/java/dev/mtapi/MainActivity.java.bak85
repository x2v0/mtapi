package dev.mtapi;

import android.annotation.SuppressLint;
import android.app.Activity;
import android.content.Intent;
import android.graphics.Color;
import android.os.Build;
import android.os.Bundle;
import android.view.View;
import android.view.ViewGroup;
import android.webkit.WebChromeClient;
import android.webkit.WebSettings;
import android.webkit.WebView;
import android.webkit.WebViewClient;
import android.widget.LinearLayout;
import android.widget.ProgressBar;
import android.widget.TextView;

/**
 * MTAPI_WEBVIEW_81: MainActivity = thin WebView that loads the local mtapi server
 * (same content as any external browser would see).
 *
 * Flow:
 *   1. onCreate → start ApiService (which spawns Go subprocess on :7788)
 *   2. show progress bar + status
 *   3. poll http://127.0.0.1:7788/ping every 200ms (up to 15s)
 *   4. once ready → load http://127.0.0.1:7788/ into WebView
 *   5. on error → show retry button
 */
public class MainActivity extends Activity {

    private WebView webView;
    private ProgressBar progress;
    private TextView status;
    private LinearLayout errorPanel;
    private boolean loaded = false;
    private Thread pollThread;

    @SuppressLint("SetJavaScriptEnabled")
    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);

        // 1. Build UI: WebView (hidden until ready) + progress + status + error panel
        webView = new WebView(this);
        webView.setVisibility(View.GONE);
        WebSettings ws = webView.getSettings();
        ws.setJavaScriptEnabled(true);
        ws.setDomStorageEnabled(true);
        ws.setCacheMode(WebSettings.LOAD_NO_CACHE);
        ws.setAllowFileAccess(false);
        ws.setAllowContentAccess(false);
        ws.setMixedContentMode(WebSettings.MIXED_CONTENT_ALWAYS_ALLOW);
        if (Build.VERSION.SDK_INT >= 21) {
            ws.setMediaPlaybackRequiresUserGesture(false);
        }
        webView.setWebViewClient(new WebViewClient() {
            @Override
            public boolean shouldOverrideUrlLoading(WebView view, String url) {
                // keep all localhost in webview
                if (url.startsWith("http://127.0.0.1:7788") || url.startsWith("http://localhost")) {
                    return false;
                }
                // external → default browser
                try {
                    startActivity(new Intent(Intent.ACTION_VIEW, android.net.Uri.parse(url)));
                } catch (Throwable ignored) {}
                return true;
            }
            @Override
            public void onPageFinished(WebView view, String url) {
                progress.setVisibility(View.GONE);
                webView.setVisibility(View.VISIBLE);
            }
        });
        webView.setWebChromeClient(new WebChromeClient());

        progress = new ProgressBar(this, null, android.R.attr.progressBarStyleHorizontal);
        progress.setIndeterminate(true);
        progress.setLayoutParams(new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, 8));

        status = new TextView(this);
        status.setText("starting mtapi server…");
        status.setTextSize(12f);
        status.setTextColor(Color.parseColor("#aaaaaa"));
        status.setPadding(24, 24, 24, 24);

        errorPanel = new LinearLayout(this);
        errorPanel.setOrientation(LinearLayout.VERTICAL);
        errorPanel.setPadding(48, 96, 48, 48);
        errorPanel.setVisibility(View.GONE);

        TextView errText = new TextView(this);
        errText.setText("server failed to start\n\ncheck: is com.w2adash or dev.mtapi granted foreground service permission?");
        errText.setTextSize(12f);
        errText.setTextColor(Color.parseColor("#f87171"));
        errText.setPadding(0, 0, 0, 24);

        android.widget.Button retryBtn = new android.widget.Button(this);
        retryBtn.setText("⟲ retry");
        retryBtn.setOnClickListener(v -> startPolling());

        android.widget.Button browserBtn = new android.widget.Button(this);
        browserBtn.setText("open in browser");
        browserBtn.setOnClickListener(v -> {
            try {
                startActivity(new Intent(Intent.ACTION_VIEW,
                        android.net.Uri.parse("http://127.0.0.1:7788/?token=" + Token.getOrCreate(MainActivity.this))));
            } catch (Throwable ignored) {}
        });

        errorPanel.addView(errText);
        errorPanel.addView(retryBtn);
        errorPanel.addView(browserBtn);

        LinearLayout root = new LinearLayout(this);
        root.setOrientation(LinearLayout.VERTICAL);
        root.addView(progress);
        root.addView(status);
        root.addView(errorPanel);
        root.addView(webView, new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f));
        setContentView(root);

        // 2. Kick off ApiService (spawns Go subprocess on :7788)
        try {
            Intent svc = new Intent(this, ApiService.class);
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
                startForegroundService(svc);
            } else {
                startService(svc);
            }
        } catch (Throwable t) {
            status.setText("startForegroundService failed: " + t);
        }

        // 3. Wait for /ping to return 200, then load SSR page
        startPolling();
    }

    private void startPolling() {
        errorPanel.setVisibility(View.GONE);
        progress.setVisibility(View.VISIBLE);
        webView.setVisibility(View.GONE);
        status.setText("starting mtapi server…");
        if (pollThread != null) pollThread.interrupt();
        pollThread = new Thread(() -> {
            long deadline = System.currentTimeMillis() + 20000L;  // 20s
            while (System.currentTimeMillis() < deadline) {
                if (Thread.currentThread().isInterrupted()) return;
                try {
                    java.net.HttpURLConnection c = (java.net.HttpURLConnection)
                            new java.net.URL("http://127.0.0.1:7788/ping").openConnection();
                    c.setConnectTimeout(500);
                    c.setReadTimeout(500);
                    c.setRequestMethod("GET");
                    int code = c.getResponseCode();
                    if (code == 200 || code == 401) {  // MTAPI_FIX84: 401 = server up (needs token)
                        // ready → load SSR page
                        runOnUiThread(() -> {
                            status.setText("loading UI…");
                            String tok = Token.getOrCreate(MainActivity.this);
                            webView.loadUrl("http://127.0.0.1:7788/?token=" + tok);
                        });
                        return;
                    }
                } catch (Throwable ignored) {}
                runOnUiThread(() -> status.setText("waiting for mtapi…"));
                try { Thread.sleep(200); } catch (InterruptedException e) { return; }
            }
            // timeout
            runOnUiThread(() -> {
                progress.setVisibility(View.GONE);
                status.setText("mtapi server not responding after 20s");
                errorPanel.setVisibility(View.VISIBLE);
            });
        }, "mtapi-poll");
        pollThread.setDaemon(true);
        pollThread.start();
    }

    @Override
    public void onBackPressed() {
        if (webView != null && webView.canGoBack()) {
            webView.goBack();
            return;
        }
        super.onBackPressed();
    }

    @Override
    protected void onDestroy() {
        if (pollThread != null) pollThread.interrupt();
        if (webView != null) {
            try { webView.destroy(); } catch (Throwable ignored) {}
        }
        super.onDestroy();
    }
}
